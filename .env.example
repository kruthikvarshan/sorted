# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Meta Model API key (dev.meta.ai). Used by the server only; it never reaches the browser.
MODEL_API_KEY=

# Optional: WhatsApp through Meta's Cloud API (see README → WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional: WhatsApp through the Twilio sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# The public https address of this server (needed to check Twilio's signatures)
PUBLIC_URL=

# Locks the trace and spend pages (any long random text)
TRACE_TOKEN=
