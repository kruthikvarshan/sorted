{
  "name": "Sorted",
  "short_name": "Sorted",
  "description": "A group chat with a member who keeps track: what's decided, who owes whom, what's still open.",
  "start_url": "/live",
  "display": "standalone",
  "background_color": "#efeae2",
  "theme_color": "#008069",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/live/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "image",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}